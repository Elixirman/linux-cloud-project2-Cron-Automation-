<svg viewBox="0 0 900 320" xmlns="http://www.w3.org/2000/svg" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
    <defs>
        <marker id="arrow2" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L0,6 L9,3 z" fill="#64748b" />
        </marker>
    </defs>
    <rect width="900" height="320" fill="#f8fafc"/>

    <rect x="20" y="30" width="180" height="80" rx="10" fill="#ffffff" stroke="#2563eb" stroke-width="2"/>
    <text x="110" y="60" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="600" fill="#1e293b">cron daemon</text>
    <text x="110" y="80" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">reads crontab</text>
    <text x="110" y="95" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">wakes every minute</text>

    <line x1="110" y1="110" x2="110" y2="150" stroke="#64748b" stroke-width="2" marker-end="url(#arrow2)"/>

    <rect x="20" y="150" width="180" height="70" rx="10" fill="#fef3c7" stroke="#f59e0b" stroke-width="2"/>
    <text x="110" y="178" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="600" fill="#92400e">02:00 daily match</text>
    <text x="110" y="196" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#92400e">0 2 * * *</text>

    <line x1="200" y1="185" x2="260" y2="185" stroke="#64748b" stroke-width="2" marker-end="url(#arrow2)"/>

    <rect x="260" y="140" width="220" height="110" rx="10" fill="#ffffff" stroke="#2563eb" stroke-width="2"/>
    <text x="370" y="165" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="600" fill="#1e293b">backup.sh</text>
    <text x="370" y="185" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">no inherited $HOME</text>
    <text x="370" y="200" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">SCRIPT_DIR from $0</text>
    <text x="370" y="215" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">no controlling terminal</text>
    <text x="370" y="230" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">runs as linux-guy</text>

    <line x1="480" y1="195" x2="540" y2="195" stroke="#64748b" stroke-width="2" marker-end="url(#arrow2)"/>

    <rect x="540" y="150" width="160" height="90" rx="10" fill="#ffffff" stroke="#10b981" stroke-width="2"/>
    <text x="620" y="180" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="600" fill="#1e293b">backups/</text>
    <text x="620" y="200" text-anchor="middle" font-family="monospace" font-size="9" fill="#64748b">backup_*.tar.gz</text>
    <text x="620" y="215" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">gitignored</text>

    <line x1="370" y1="250" x2="370" y2="280" stroke="#64748b" stroke-width="2" marker-end="url(#arrow2)"/>
    <rect x="240" y="280" width="260" height="35" rx="8" fill="#e0e7ff" stroke="#6366f1" stroke-width="1.5"/>
    <text x="370" y="302" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#3730a3" font-weight="600">backup.log ( &gt;&gt; ... 2&gt;&amp;1 )</text>

    <rect x="700" y="30" width="180" height="80" rx="10" fill="#ffffff" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4,3"/>
    <text x="790" y="58" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="600" fill="#475569">Interactive shell</text>
    <text x="790" y="76" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">$HOME, $PATH, tty</text>
    <text x="790" y="91" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#64748b">present — NOT used by cron</text>
</svg>
